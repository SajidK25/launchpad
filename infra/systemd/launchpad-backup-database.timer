[Unit]
Description=Weekly Launchpad database and configuration backup

[Timer]
# Override OnCalendar with a timer drop-in for another off-peak UTC schedule.
OnCalendar=Sun *-*-* 03:00:00 UTC
Persistent=true
RandomizedDelaySec=15m
AccuracySec=1min
Unit=launchpad-backup-database.service

[Install]
WantedBy=timers.target
