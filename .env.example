# Local Docker Compose configuration. These values are development-only.
LAUNCHPAD_ENVIRONMENT=development
LAUNCHPAD_DATABASE_URL=postgresql://launchpad_development:launchpad_development_password@postgres:5432/launchpad_development
LAUNCHPAD_STORAGE_ENDPOINT_URL=http://minio:9000
LAUNCHPAD_REDIS_URL=redis://redis:6379/0
LAUNCHPAD_STORAGE_BUCKET=launchpad-private

# Runtime storage credentials are distinct from bootstrap credentials.
LAUNCHPAD_STORAGE_ACCESS_KEY_ID=launchpad_development_minio_runtime
LAUNCHPAD_STORAGE_SECRET_ACCESS_KEY=launchpad_development_minio_runtime_password
LAUNCHPAD_BOOTSTRAP_STORAGE_ACCESS_KEY_ID=launchpad_development_minio
LAUNCHPAD_BOOTSTRAP_STORAGE_SECRET_ACCESS_KEY=launchpad_development_minio_password

# Disposable local mail and encryption settings. Supply independent values outside local/check.
LAUNCHPAD_MAIL_WEB_ORIGIN=http://localhost:8080
LAUNCHPAD_MAIL_SENDER=noreply@example.com
LAUNCHPAD_SMTP_HOST=mailpit
LAUNCHPAD_SMTP_PORT=1025
LAUNCHPAD_SMTP_USE_TLS=false
LAUNCHPAD_OUTBOX_KEY_ID=development-v1
# Base64-encoded 32-byte local-only key; never reuse in a deployed environment.
LAUNCHPAD_OUTBOX_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
LAUNCHPAD_PUBLIC_UPLOAD_ENDPOINT_URL=http://localhost:9000

# Session policy is fixed: host-only Secure SameSite=Lax cookie, 24-hour idle, 7-day absolute.
LAUNCHPAD_SESSION_COOKIE_NAME=__Host-launchpad_session
LAUNCHPAD_SESSION_COOKIE_SECURE=true
LAUNCHPAD_SESSION_COOKIE_SAMESITE=lax
LAUNCHPAD_SESSION_IDLE_SECONDS=86400
LAUNCHPAD_SESSION_ABSOLUTE_SECONDS=604800
