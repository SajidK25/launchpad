{
  "name": "launchpad",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build --workspace=@launchpad/web",
    "contracts:generate": "npm run generate --workspace=@launchpad/contracts",
    "format:check": "prettier --check .",
    "lint": "npm run lint --workspace=@launchpad/web",
    "test": "npm run test --workspace=@launchpad/web",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts",
    "typecheck": "npm run typecheck --workspace=@launchpad/web"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/node": "24.3.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.33.0",
    "globals": "16.3.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.39.1",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
